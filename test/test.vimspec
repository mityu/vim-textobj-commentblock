let g:assert = themis#helper('assert')


Describe textobj-commentblock

  Before  all
    nnoremap <Plug>(op-delete) d
    nmap @ <Plug>(op-delete)<Plug>(test-target)

    let g:buffer = ['line1', 'line2', 'line3']
    lockvar! g:buffer
  End

  Before each
    % delete _
  End

  Context oneline
    Before all
      let b:textobj_commentblock_oneline = '//'
      let g:comment = b:textobj_commentblock_oneline . 'comment'
    End

    Context select-inner
      Before all
        omap <Plug>(test-target) <Plug>(textobj-commentblock-i)
      End

      It removes oneline comment at hatpos
        const before =<< trim END
          //comment
        END
        call setline(1, before)
        normal! $
        normal @
        const after =<< trim END
          //
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment at hatpos from head of comment
        const before =<< trim END
          //comment
        END
        call setline(1, before)
        normal! ^
        normal @
        const after =<< trim END
          //
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment at dollerpos
        const before =<< trim END
          line//comment
        END
        call setline(1, before)
        normal! $
        normal @
        const after =<< trim END
          line//
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment block 1
        const before =<< trim END
          line1
          //comment1
          //comment2
          line2
        END
        call setline(1, before)
        call cursor(2, 3)
        normal @
        const after =<< trim END
          line1
          //
          line2
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment block 2
        const before =<< trim END
          line1
          line2//comment1
          //comment2
          line3
        END
        call setline(1, before)
        call cursor(3, 0)
        normal @
        const after =<< trim END
          line1
          line2//comment1
          //
          line3
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment block 3
        const before =<< trim END
          line1
          line2//comment1
          //comment2
          line3
        END
        call setline(1, before)
        normal! 2G$
        normal @
        const after =<< trim END
          line1
          line2//
          //comment2
          line3
        END
        call g:assert.equals(getline(1, '$'), after)
      End
    End

    Context select-all
      Before all
        omap <Plug>(test-target) <Plug>(textobj-commentblock-a)
      End

      It removes oneline comment at hatpos
        const before =<< trim END
          //comment
        END
        call setline(1, before)
        normal @
        call g:assert.equals(getline(1, '$'), [''])
      End

      It removes oneline comment at dollerpos
        const before =<< trim END
          line//comment
        END
        call setline(1, before)
        normal! $
        normal @
        const after =<< trim END
          line
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment block 1
        const before =<< trim END
          line1
          //comment1
          //comment2
          line2
        END
        call setline(1, before)
        call cursor(2, 3)
        normal @
        const after =<< trim END
          line1
          line2
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment block 2
        const before =<< trim END
          line1
          line2//comment1
          //comment2
          line3
        END
        call setline(1, before)
        call cursor(3, 0)
        normal @
        const after =<< trim END
          line1
          line2//comment1
          line3
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes oneline comment block 3
        const before =<< trim END
          line1
          line2//comment1
          //comment2
          line3
        END
        call setline(1, before)
        normal! 2G$
        normal @
        const after =<< trim END
          line1
          line2
          //comment2
          line3
        END
        call g:assert.equals(getline(1, '$'), after)
      End
    End

    After all
      unlet b:textobj_commentblock_oneline
    End
  End

  Context wrap
    Before all
      let b:textobj_commentblock_wrap = ['/*', '*/']
    End

    Context select-inner
      Before all
        omap <Plug>(test-target) <Plug>(textobj-commentblock-i)
      End

      It removes oneline wrap comment
        const before =<< trim END
          /*comment*/
        END
        call setline(1, before)
        normal! ^fm
        normal @
        const after =<< trim END
          /**/
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 1
        const before =<< trim END
          /*comment
          comment
          comment*/
        END
        call setline(1, before)
        normal! ^fm
        normal @
        const after =<< trim END
          /**/
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 2
        const before =<< trim END
          /*
          comment
          */
        END
        call setline(1, before)
        call cursor(2, 0)
        normal @
        const after =<< trim END
          /**/
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 3
        const before =<< trim END
          line1
          /*comment
          comment
          comment*/
          line2
        END
        call setline(1, before)
        call cursor(3, 0)
        normal @
        const after =<< trim END
          line1
          /**/
          line2
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 4
        const before =<< trim END
          line1
          /*
          comment
          */
          line2
        END
        call setline(1, before)
        call cursor(3, 0)
        normal @
        const after =<< trim END
          line1
          /**/
          line2
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 5
        const before =<< trim END
          /*comment*/
        END
        call setline(1, before)
        normal! ^
        normal @
        const after =<< trim END
          /**/
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 6
        const before =<< trim END
          /*
          */
        END
        call setline(1, before)
        normal @
        const after =<< trim END
          /**/
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes nothing in wrap comment
        const before =<< trim END
          /**/
        END
        call setline(1, before)
        normal @
        const after =<< trim END
          /**/
        END
        call g:assert.equals(getline(1, '$'), after)
      End
    End

    Context select-all
      Before all
        omap <Plug>(test-target) <Plug>(textobj-commentblock-a)
      End

      It removes oneline wrap comment
        const before =<< trim END
          /*comment*/
        END
        call setline(1, before)
        normal! ^fm
        normal @
        call g:assert.equals(getline(1, '$'), [''])
      End

      It removes oneline wrap comment from the edge position
        const before =<< trim END
          /*comment*/
        END
        call setline(1, before)
        normal! ^
        normal @
        call g:assert.equals(getline(1, '$'), [''])
      End

      It removes multiline wrap comment 1
        const before =<< trim END
          /*comment
          comment
          comment*/
        END
        call setline(1, before)
        normal! ^fm
        normal @
        call g:assert.equals(getline(1, '$'), [''])
      End

      It removes multiline wrap comment 2
        const before =<< trim END
          /*
          comment
          */
        END
        call setline(1, before)
        call cursor(2, 0)
        normal @
        call g:assert.equals(getline(1, '$'), [''])
      End

      It removes multiline wrap comment 3
        const before =<< trim END
          line1
          /*comment
          comment
          comment*/
          line2
        END
        call setline(1, before)
        call cursor(3, 0)
        normal @
        const after =<< trim END
          line1

          line2
        END
        call g:assert.equals(getline(1, '$'), after)
      End

      It removes multiline wrap comment 4
        const before =<< trim END
          line1
          /*
          comment
          */
          line2
        END
        call setline(1, before)
        call cursor(3, 0)
        normal @
        const after =<< trim END
          line1

          line2
        END
        call g:assert.equals(getline(1, '$'), after)
      End
    End

    After all
      unlet b:textobj_commentblock_wrap
    End
  End

End
